<?xml version="1.0"?>
<ruleset name="Nexora" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<description>WordPress Coding Standards for the Nexora plugin.</description>

	<file>nexora.php</file>
	<file>src</file>
	<file>templates</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/lib/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg value="ps"/>

	<!-- Runs on PHP 8.0+ -->
	<config name="testVersion" value="8.0-"/>
	<config name="minimum_wp_version" value="6.4"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- Classes are PSR-4 (src/Auth/Login.php), not class-login.php -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="nexora"/>
			</property>
		</properties>
	</rule>

	<!-- Everything global is prefixed nexora_ / Nexora. Option, meta and AJAX-alias names that already exist
	     on the live site are part of the compatibility contract and are kept as they are. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="nexora"/>
				<element value="Nexora"/>
			</property>
		</properties>
	</rule>
</ruleset>
