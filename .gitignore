# Secrets / environment
.env
wp-config.php

# Dependencies
node_modules/
vendor/

# Logs / OS
*.log
.DS_Store

# Backups, caches, uploads (never commit; contain user data)
wp-content/updraft/
wp-content/ai1wm-backups/
wp-content/litespeed/
wp-content/cache/
wp-content/uploads/
wp-content/upgrade/
*.sql
*.sql.gz
*.wpress
skill-outputs/

# Third-party plugins are installed through wp-admin, not committed: ignore everything in
# wp-content/plugins except the Nexora plugin. (Plugins already tracked stay tracked.)
/wp-content/plugins/*
!/wp-content/plugins/nexora/

# Generated by the Jetpack firewall
/wp-content/jetpack-waf/

# Archives (plugin zips, exports)
*.zip
